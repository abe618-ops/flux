<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F2EA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="印度占星·问事足球"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2F251D" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="一键 Prashna · 当前分钟 · Lahiri · D1 / D9"
            android:textSize="13sp"
            android:textColor="#756A61" />

        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/card_bg">

            <TextView
                android:id="@+id/verdictText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="点击“立即起盘”"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#5A321C" />

            <TextView
                android:id="@+id/probText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="主胜 —   平 —   客胜 —"
                android:textSize="17sp"
                android:textColor="#2F251D" />

            <TextView
                android:id="@+id/sensitivityText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="分钟敏感性：—"
                android:textSize="13sp"
                android:textColor="#756A61" />

            <TextView
                android:id="@+id/summaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="无需输入主客队、问题、时间、时区或经纬度。"
                android:textSize="14sp"
                android:textColor="#40362E" />
        </LinearLayout>

        <Button
            android:id="@+id/analyzeButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:text="立即起盘"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/autoInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="自动读取：当前分钟 · 系统时区 · 手机位置"
            android:textSize="12sp"
            android:textColor="#756A61" />

        <TextView
            android:id="@+id/chartToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="10dp"
            android:text="▶ 排盘详情（D1 / D9 / 星曜位置）"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#3D2A1C" />

        <LinearLayout
            android:id="@+id/chartSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/chartMetaText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textSize="13sp"
                android:textColor="#4D433B" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="D1 Rāśi"
                android:textStyle="bold"
                android:textSize="16sp" />

            <com.abe.vedicprashna.VedicChartView
                android:id="@+id/d1Chart"
                android:layout_width="match_parent"
                android:layout_height="320dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="D9 Navāṁśa"
                android:textStyle="bold"
                android:textSize="16sp" />

            <com.abe.vedicprashna.VedicChartView
                android:id="@+id/d9Chart"
                android:layout_width="match_parent"
                android:layout_height="320dp" />

            <TextView
                android:id="@+id/planetTableText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:typeface="monospace"
                android:textSize="12sp"
                android:textColor="#3C332C" />
        </LinearLayout>

        <TextView
            android:id="@+id/analysisToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:text="▶ 分析规则与评分明细"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#3D2A1C" />

        <LinearLayout
            android:id="@+id/analysisSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/analysisDetailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textSize="13sp"
                android:textColor="#3C332C" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingBottom="24dp"
            android:text="固定映射：主方=第1宫，客方=第7宫。占星属于传统术数方法；百分比为内部规则权重，并非统计学胜率。"
            android:textSize="12sp"
            android:textColor="#7A6E64" />
    </LinearLayout>
</ScrollView>
