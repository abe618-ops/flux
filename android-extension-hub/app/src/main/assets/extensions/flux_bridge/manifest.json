{
  "manifest_version": 2,
  "name": "Flux WebOS Bridge",
  "version": "0.1.0",
  "description": "Built-in bridge extension for the Flux WebOS Android shell.",
  "browser_specific_settings": {
    "gecko": {
      "id": "flux-bridge@flux.local"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
