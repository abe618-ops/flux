{
  "manifest_version": 3,
  "name": "CodexMeter Web",
  "version": "1.0.0",
  "description": "Real Codex quota and token dashboard for ChatGPT.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "CodexMeter", "default_popup": "dashboard.html"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}